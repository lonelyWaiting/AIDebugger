#!/bin/sh

#
# Gradle start up script for POSIX generated by Gradle.
# Minimal wrapper — mirrors gradlew.bat behaviour.
#

# Resolve script directory
APP_DIR="$(cd "$(dirname "$0")" && pwd)"

# Determine java command
if [ -n "$JAVA_HOME" ]; then
    JAVA_EXE="$JAVA_HOME/bin/java"
    if [ ! -x "$JAVA_EXE" ]; then
        echo "ERROR: JAVA_HOME is set to an invalid directory: $JAVA_HOME" >&2
        echo "Please set JAVA_HOME to a valid JDK installation." >&2
        exit 1
    fi
else
    JAVA_EXE="java"
    if ! command -v java >/dev/null 2>&1; then
        echo "ERROR: JAVA_HOME is not set and 'java' is not in the PATH." >&2
        exit 1
    fi
fi

exec "$JAVA_EXE" \
    -Xmx64m -Xms64m \
    -classpath "$APP_DIR/gradle/wrapper/gradle-wrapper.jar" \
    org.gradle.wrapper.GradleWrapperMain \
    "$@"
