{
  "_comment": "Template only. VS registers AIDebuggerVS; Rider registers AIDebuggerRider.",
  "_note": "The Python MCP server files are bundled with each extension (VSIX/Rider).",
  "mcpServers": {
    "AIDebuggerVS": {
      "command": "python",
      "args": ["<auto-detected-by-extension>/mcp_server/server.py"],
      "env": {
        "AIDB_PREFERRED_IDE": "vs"
      }
    },
    "AIDebuggerRider": {
      "command": "python",
      "args": ["<auto-detected-by-extension>/mcp_server/server.py"],
      "env": {
        "AIDB_PREFERRED_IDE": "rider"
      }
    }
  }
}
