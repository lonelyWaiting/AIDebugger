<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RiderBuildDummy.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GradleProjectDir>$(MSBuildProjectDirectory)\RiderDebuggerMCP</GradleProjectDir>
    <GradleWrapper>$(GradleProjectDir)\gradlew.bat</GradleWrapper>
    <GradleBuildId>$([System.Guid]::NewGuid().ToString("N"))</GradleBuildId>
    <GradleUserHome>$(TEMP)\AIDebuggerGradle\cache</GradleUserHome>
    <GradleCommand Condition="Exists('$(GradleWrapper)')">"$(GradleWrapper)" -p "$(GradleProjectDir)" --no-daemon --gradle-user-home "$(GradleUserHome)"</GradleCommand>
    <GradleCommand Condition="'$(GradleCommand)' == ''">gradle -p "$(GradleProjectDir)" --no-daemon --gradle-user-home "$(GradleUserHome)"</GradleCommand>
    <RiderBuildDir>$(GradleProjectDir)\build-$(GradleBuildId)</RiderBuildDir>
    <RiderPluginOutputDir>$(RiderBuildDir)\distributions</RiderPluginOutputDir>
    <RiderBuildRetention>3</RiderBuildRetention>
    <RiderJbrHome Condition="'$(RIDER_JBR)' != ''">$(RIDER_JBR)</RiderJbrHome>
    <RiderJbrHome Condition="'$(RiderJbrHome)' == '' and Exists('C:\\Program Files\\JetBrains\\JetBrains Rider 2025.1.2\\jbr')">C:\Program Files\JetBrains\JetBrains Rider 2025.1.2\jbr</RiderJbrHome>
    <GradleEnvironment>GRADLE_USER_HOME=$(GradleUserHome);AIDB_GRADLE_BUILD_ID=$(GradleBuildId)</GradleEnvironment>
    <GradleEnvironment Condition="'$(RiderJbrHome)' != ''">JAVA_HOME=$(RiderJbrHome);GRADLE_USER_HOME=$(GradleUserHome);AIDB_GRADLE_BUILD_ID=$(GradleBuildId)</GradleEnvironment>
  </PropertyGroup>

  <Target Name="BuildRiderPlugin" AfterTargets="Build">
    <Message Importance="high" Text="Building Rider plugin via Gradle..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$d='$(GradleUserHome)\\wrapper\\dists'; if (Test-Path $d) { Get-ChildItem -Path $d -Recurse -Filter *.zip.lck -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; Get-ChildItem -Path $d -Recurse -Filter *.zip.part -ErrorAction SilentlyContinue | ForEach-Object { $zip = $_.FullName.Substring(0, $_.FullName.Length - 5); if (!(Test-Path $zip)) { Copy-Item -Path $_.FullName -Destination $zip -Force -ErrorAction SilentlyContinue } } }&quot;" />
    <Delete Files="$(RiderPluginOutputDir)\*.zip" Condition="Exists('$(RiderPluginOutputDir)')" />
    <Exec Command="$(GradleCommand) buildPlugin" EnvironmentVariables="$(GradleEnvironment)" />
    <ItemGroup>
      <RiderPluginZips Include="$(RiderPluginOutputDir)\*.zip" />
    </ItemGroup>
    <Error Condition="'@(RiderPluginZips)' == ''" Text="Rider plugin build failed: no ZIP found in $(RiderPluginOutputDir)." />
  </Target>

  <Target Name="CleanupRiderBuilds" AfterTargets="BuildRiderPlugin">
    <Message Importance="low" Text="Cleaning old Rider build directories (keeping last $(RiderBuildRetention))." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$root='$(GradleProjectDir)'; if (Test-Path $root) { $current=[System.IO.Path]::GetFullPath('$(RiderBuildDir)'); $keep=[Math]::Max([int]'$(RiderBuildRetention)',1); $dirs=Get-ChildItem -Path $root -Directory -Filter 'build-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending; $kept=$dirs | Select-Object -First $keep; $toDelete=$dirs | Where-Object { $kept -notcontains $_ -and $_.FullName -ne $current }; foreach ($dir in $toDelete) { try { Get-ChildItem -LiteralPath $dir.FullName -Recurse -Force -ErrorAction SilentlyContinue | ForEach-Object { $_.Attributes = 'Normal' }; Remove-Item -LiteralPath $dir.FullName -Recurse -Force -ErrorAction Stop } catch { Write-Host ('CleanupRiderBuilds: failed to delete ' + $dir.FullName + ': ' + $_.Exception.Message) } if (Test-Path $dir.FullName) { Write-Host ('CleanupRiderBuilds: still exists ' + $dir.FullName) } } }&quot;" />
  </Target>

  <Target Name="CleanRiderPlugin">
    <Exec Command="$(GradleCommand) clean" EnvironmentVariables="$(GradleEnvironment)" />
  </Target>
</Project>
