<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="RiderBuildDummy.cs" />
  </ItemGroup>

  <PropertyGroup>
    <GradleProjectDir>$(MSBuildProjectDirectory)\RiderDebuggerMCP</GradleProjectDir>
    <GradleWrapper>$(GradleProjectDir)\gradlew.bat</GradleWrapper>
    <!--
      Build directory strategy:
      - If AIDB_GRADLE_BUILD_ID is set (e.g. from CI), use build-<id> for isolation.
      - Otherwise use the default 'build' directory for incremental compilation.
    -->
    <GradleBuildId Condition="'$(AIDB_GRADLE_BUILD_ID)' != ''">$(AIDB_GRADLE_BUILD_ID)</GradleBuildId>
    <GradleUserHome>$(TEMP)\AIDebuggerGradle\cache</GradleUserHome>
    <!--
      Local builds: let gradle.properties control daemon (daemon=true for warm JVM reuse).
      CI builds: pass ==no-daemon explicitly via AIDB_GRADLE_BUILD_ID presence.
    -->
    <GradleDaemonArg Condition="'$(GradleBuildId)' != ''">--no-daemon</GradleDaemonArg>
    <GradleDaemonArg Condition="'$(GradleBuildId)' == ''"></GradleDaemonArg>
    <GradleCommand Condition="Exists('$(GradleWrapper)')">"$(GradleWrapper)" -p "$(GradleProjectDir)" $(GradleDaemonArg) --gradle-user-home "$(GradleUserHome)"</GradleCommand>
    <GradleCommand Condition="'$(GradleCommand)' == ''">gradle -p "$(GradleProjectDir)" $(GradleDaemonArg) --gradle-user-home "$(GradleUserHome)"</GradleCommand>
    <RiderBuildDir Condition="'$(GradleBuildId)' != ''">$(GradleProjectDir)\build-$(GradleBuildId)</RiderBuildDir>
    <RiderBuildDir Condition="'$(GradleBuildId)' == ''">$(GradleProjectDir)\build</RiderBuildDir>
    <RiderPluginOutputDir>$(RiderBuildDir)\distributions</RiderPluginOutputDir>
    <RiderBuildRetention>3</RiderBuildRetention>
    <!--
      JBR (JetBrains Runtime) detection priority:
      1. RIDER_JBR environment variable (explicit override)
      2. JAVA_HOME if already JDK 17+ (GitHub Actions / CI)
      3. RIDER_HOME environment variable + /jbr
      4. Auto-detect from installed Rider (dynamic, no hardcoded versions)
    -->
    <RiderJbrHome Condition="'$(RIDER_JBR)' != ''">$(RIDER_JBR)</RiderJbrHome>
    <RiderJbrHome Condition="'$(RiderJbrHome)' == '' and '$(RIDER_HOME)' != '' and Exists('$(RIDER_HOME)\jbr')">$(RIDER_HOME)\jbr</RiderJbrHome>
    <!-- JetBrains install directories to search -->
    <JetBrainsDir Condition="Exists('C:\Program Files\JetBrains')">C:\Program Files\JetBrains</JetBrainsDir>
    <JetBrainsDir Condition="'$(JetBrainsDir)' == '' and Exists('$(LOCALAPPDATA)\JetBrains\Toolbox\apps')">$(LOCALAPPDATA)\JetBrains\Toolbox\apps</JetBrainsDir>
  </PropertyGroup>

  <!-- Target to dynamically detect Rider JBR before building -->
  <Target Name="DetectRiderJbr" BeforeTargets="BuildRiderPlugin" Condition="'$(RiderJbrHome)' == '' and '$(JetBrainsDir)' != ''">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$dirs = Get-ChildItem -Path '$(JetBrainsDir)' -Directory -Filter 'JetBrains Rider*' -ErrorAction SilentlyContinue | Sort-Object Name -Descending; foreach ($d in $dirs) { $jbr = Join-Path $d.FullName 'jbr'; if (Test-Path $jbr) { Write-Output $jbr; exit 0 } }; $tbDirs = Get-ChildItem -Path '$(LOCALAPPDATA)\JetBrains\Toolbox\apps' -Directory -Filter 'Rider*' -ErrorAction SilentlyContinue; foreach ($td in $tbDirs) { $channels = Get-ChildItem -Path $td.FullName -Directory -ErrorAction SilentlyContinue | Sort-Object Name -Descending; foreach ($ch in $channels) { $jbr = Join-Path $ch.FullName 'jbr'; if (Test-Path $jbr) { Write-Output $jbr; exit 0 } } }&quot;"
            ConsoleToMSBuild="true"
            StandardOutputImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_DetectedJbrPath" />
    </Exec>
    <PropertyGroup>
      <RiderJbrHome Condition="'$(_DetectedJbrPath)' != ''">$(_DetectedJbrPath.Trim())</RiderJbrHome>
    </PropertyGroup>
    <Message Importance="high" Text="Auto-detected Rider JBR: $(RiderJbrHome)" Condition="'$(RiderJbrHome)' != ''" />
    <Message Importance="high" Text="No Rider JBR found. Using system JAVA_HOME or default Java." Condition="'$(RiderJbrHome)' == ''" />
  </Target>

  <!-- Set GradleEnvironment after JBR detection -->
  <Target Name="SetGradleEnvironment" BeforeTargets="BuildRiderPlugin" DependsOnTargets="DetectRiderJbr">
    <PropertyGroup>
      <GradleEnvironment Condition="'$(GradleBuildId)' != ''">GRADLE_USER_HOME=$(GradleUserHome);AIDB_GRADLE_BUILD_ID=$(GradleBuildId)</GradleEnvironment>
      <GradleEnvironment Condition="'$(GradleBuildId)' == ''">GRADLE_USER_HOME=$(GradleUserHome)</GradleEnvironment>
      <GradleEnvironment Condition="'$(RiderJbrHome)' != ''">JAVA_HOME=$(RiderJbrHome);$(GradleEnvironment)</GradleEnvironment>
    </PropertyGroup>
  </Target>

  <Target Name="BuildRiderPlugin" AfterTargets="Build">
    <Message Importance="high" Text="Building Rider plugin via Gradle..." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$d='$(GradleUserHome)\\wrapper\\dists'; if (Test-Path $d) { Get-ChildItem -Path $d -Recurse -Filter *.zip.lck -ErrorAction SilentlyContinue | Remove-Item -Force -ErrorAction SilentlyContinue; Get-ChildItem -Path $d -Recurse -Filter *.zip.part -ErrorAction SilentlyContinue | ForEach-Object { $zip = $_.FullName.Substring(0, $_.FullName.Length - 5); if (!(Test-Path $zip)) { Copy-Item -Path $_.FullName -Destination $zip -Force -ErrorAction SilentlyContinue } } }&quot;" />
    <Delete Files="$(RiderPluginOutputDir)\*.zip" Condition="Exists('$(RiderPluginOutputDir)')" />
    <Exec Command="$(GradleCommand) buildPlugin" EnvironmentVariables="$(GradleEnvironment)" />
    <ItemGroup>
      <RiderPluginZips Include="$(RiderPluginOutputDir)\*.zip" />
    </ItemGroup>
    <Error Condition="'@(RiderPluginZips)' == ''" Text="Rider plugin build failed: no ZIP found in $(RiderPluginOutputDir)." />
  </Target>

  <!-- Only clean up GUID-based build dirs; the default 'build' dir is kept for incremental builds -->
  <Target Name="CleanupRiderBuilds" AfterTargets="BuildRiderPlugin" Condition="'$(GradleBuildId)' != ''">
    <Message Importance="low" Text="Cleaning old Rider build directories (keeping last $(RiderBuildRetention))." />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$root='$(GradleProjectDir)'; if (Test-Path $root) { $current=[System.IO.Path]::GetFullPath('$(RiderBuildDir)'); $keep=[Math]::Max([int]'$(RiderBuildRetention)',1); $dirs=Get-ChildItem -Path $root -Directory -Filter 'build-*' -ErrorAction SilentlyContinue | Sort-Object LastWriteTime -Descending; $kept=$dirs | Select-Object -First $keep; $toDelete=$dirs | Where-Object { $kept -notcontains $_ -and $_.FullName -ne $current }; foreach ($dir in $toDelete) { try { Get-ChildItem -LiteralPath $dir.FullName -Recurse -Force -ErrorAction SilentlyContinue | ForEach-Object { $_.Attributes = 'Normal' }; Remove-Item -LiteralPath $dir.FullName -Recurse -Force -ErrorAction Stop } catch { Write-Host ('CleanupRiderBuilds: failed to delete ' + $dir.FullName + ': ' + $_.Exception.Message) } if (Test-Path $dir.FullName) { Write-Host ('CleanupRiderBuilds: still exists ' + $dir.FullName) } } }&quot;" />
  </Target>

  <Target Name="CleanRiderPlugin">
    <Exec Command="$(GradleCommand) clean" EnvironmentVariables="$(GradleEnvironment)" />
  </Target>
</Project>
